---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import {
  displayStatus,
  displayStatusLabel,
  displayStatusPill,
  deploymentLabel,
  revenueEngineLabel,
  tierForStatus,
  tierCta,
  stageLabel,
  CONTACT_LINE,
  type Deployment,
} from '~/lib/taxonomy';

export async function getStaticPaths() {
  const entries = await getCollection('products', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.data.code },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'products'> };
const { entry } = Astro.props;
const p = entry.data;
const { Content } = await entry.render();

const tier = tierForStatus[p.status];
const ds = displayStatus(p.status);
const isOnPrem = p.deployment.includes('on-prem');
const host = p.domain ? new URL(p.domain).host : null;
const showCapabilities = (tier === 'full' || tier === 'preview') && p.capabilities.length > 0;

// Related products — same category first, topped up by same stage, self excluded.
const all = (await getCollection('products', ({ data }) => !data.draft)).map((e) => e.data);
const sameCat = all.filter((x) => x.code !== p.code && x.category === p.category);
const sameStage = all.filter(
  (x) => x.code !== p.code && x.stage === p.stage && x.category !== p.category,
);
const related = [...sameCat, ...sameStage].slice(0, 4);
---

<BaseLayout title={`${p.code} — ${p.title} · g8suite`} description={p.tagline}>
  <Nav />
  <main id="main" class="pt-24 lg:pt-28">
    <div class="container-page pb-24">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="py-5 text-sm text-faint">
        <a href="/our-solutions" class="hover:text-body">Our Solutions</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span>{p.category}</span>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-muted">{p.code}</span>
      </nav>

      <!-- Product card: visual (left) + info (right) -->
      <article class="grid gap-8 border border-line bg-card p-6 lg:grid-cols-2 lg:gap-12 lg:p-10">
        <!-- Visual plate -->
        <div class="flex flex-col">
          <div class="perimeter grid-ground relative flex min-h-[320px] flex-col justify-between bg-soft p-6 lg:min-h-[380px]">
            <span class="corner-bl" aria-hidden="true"></span>
            <span class="corner-br" aria-hidden="true"></span>
            <div class="flex items-center justify-between">
              <span class="mono-label">{p.category}</span>
              <span class={displayStatusPill[ds]}>{displayStatusLabel[ds]}</span>
            </div>
            <div class="text-center">
              <p class="font-mono text-4xl font-bold leading-none text-body sm:text-5xl">{p.code}</p>
              {p.alias && <p class="mt-3 text-sm text-faint">{p.alias}</p>}
            </div>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class="text-xs font-medium text-faint">{stageLabel[p.stage]}</span>
              <span class="font-mono text-xs text-brass">g8suite</span>
            </div>
          </div>

          <!-- Thumbnail strip = the services this product works with -->
          {p.spine.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {p.spine.map((s) => (
                <a
                  href={`/our-solutions/${s}`}
                  class="border border-line bg-card px-3 py-2 font-mono text-xs font-semibold text-body transition-colors hover:border-brass hover:bg-soft"
                >
                  {s}
                </a>
              ))}
            </div>
          )}
        </div>

        <!-- Info -->
        <div class="flex flex-col">
          <p class="font-mono text-sm text-brass">{p.code}{p.alias && <span class="text-faint"> · {p.alias}</span>}</p>
          <h1 class="mt-1.5 text-2xl font-semibold leading-tight text-body sm:text-3xl">{p.title}</h1>

          <!-- Meta row (rating-equivalent) -->
          <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
            <span>{stageLabel[p.stage]}</span>
            <span class="text-line-strong" aria-hidden="true">|</span>
            <span>{p.category}</span>
            <span class="text-line-strong" aria-hidden="true">|</span>
            <span>{p.deployment.map((d: Deployment) => deploymentLabel[d]).join(' · ')}</span>
          </div>

          <p class="mt-5 text-lg leading-relaxed text-muted">{p.tagline}</p>

          <!-- Pricing box (price-equivalent — never a figure) -->
          <div class="mt-6 border border-brass/30 bg-brass/[0.06] p-5">
            <p class="mono-label">Pricing &amp; licensing</p>
            <p class="mt-1.5 text-xl font-semibold text-body">{CONTACT_LINE}</p>
          </div>

          <!-- Spec rows -->
          <dl class="mt-6 space-y-4 border-t border-line pt-6">
            <div class="flex flex-wrap gap-x-4 gap-y-1.5">
              <dt class="w-36 shrink-0 text-sm text-faint">Deployment</dt>
              <dd class="flex flex-1 flex-wrap gap-2">
                {p.deployment.map((d: Deployment) => (
                  <span class="border border-line px-2.5 py-1 text-xs font-medium text-body">{deploymentLabel[d]}</span>
                ))}
              </dd>
            </div>
            <div class="flex flex-wrap gap-x-4 gap-y-1.5">
              <dt class="w-36 shrink-0 text-sm text-faint">Commercial model</dt>
              <dd class="flex-1 text-sm text-body">{revenueEngineLabel[p.revenueEngine]}</dd>
            </div>
            {p.spine.length > 0 && (
              <div class="flex flex-wrap gap-x-4 gap-y-1.5">
                <dt class="w-36 shrink-0 text-sm text-faint">Works with</dt>
                <dd class="flex flex-1 flex-wrap gap-2">
                  {p.spine.map((s) => (
                    <a href={`/our-solutions/${s}`} class="border border-line px-2.5 py-1 font-mono text-xs font-semibold text-body transition-colors hover:border-brass hover:bg-soft">
                      {s}
                    </a>
                  ))}
                </dd>
              </div>
            )}
            {isOnPrem && (
              <div class="flex flex-wrap gap-x-4 gap-y-1.5">
                <dt class="w-36 shrink-0 text-sm text-faint">Sovereignty</dt>
                <dd class="flex-1 text-sm text-body">Runs inside your perimeter — on-premise and air-gap capable.</dd>
              </div>
            )}
          </dl>

          <!-- CTA -->
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/#contact" class="btn-primary">{tierCta[tier]}</a>
            {host && (
              <a href={p.domain} rel="noopener" class="btn-ghost">
                Open {host}
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M5 3h6v6M11 3L4 10" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </article>

      <!-- Overview + capabilities -->
      <section class="mt-16 grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-faint">Overview</h2>
          <div class="prose-body mt-4 max-w-none text-lg leading-relaxed text-muted [&>p]:mt-5 [&>p:first-child]:mt-0">
            <Content />
          </div>

          {tier === 'interest' && (
            <p class="mt-8 border border-line bg-soft p-5 text-sm text-muted">
              This product is on the roadmap. Detailed capabilities and availability are shared with interested organisations directly.
            </p>
          )}
        </div>

        {showCapabilities && (
          <aside class="lg:col-span-5">
            <div class="border border-line bg-card p-6 lg:sticky lg:top-28">
              <h2 class="text-sm font-semibold uppercase tracking-wider text-faint">Capabilities</h2>
              <ul class="mt-4 space-y-3">
                {p.capabilities.map((cap) => (
                  <li class="flex gap-3 text-muted">
                    <svg class="mt-1 h-4 w-4 flex-none text-green" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <path d="M3 8.5l3 3 7-7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>{cap}</span>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )}
      </section>

      <!-- Related products -->
      {related.length > 0 && (
        <section class="mt-16 border-t border-line pt-12">
          <h2 class="text-lg font-semibold text-body">Related products</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((r) => {
              const rds = displayStatus(r.status);
              return (
                <a
                  href={`/our-solutions/${r.code}`}
                  class={`group flex h-full flex-col border p-5 transition-all hover:-translate-y-0.5 hover:border-brass hover:shadow-elevated ${
                    rds === 'live' ? 'border-brass/40 bg-card ring-1 ring-brass/10' : 'border-line bg-card'
                  }`}
                >
                  <p class="text-xs font-medium text-faint">{r.category}</p>
                  <div class="mt-1.5 flex items-start justify-between gap-3">
                    <h3 class="font-mono text-base font-bold text-body">{r.code}</h3>
                    <span class={displayStatusPill[rds]}>{displayStatusLabel[rds]}</span>
                  </div>
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{r.tagline}</p>
                </a>
              );
            })}
          </div>
        </section>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
