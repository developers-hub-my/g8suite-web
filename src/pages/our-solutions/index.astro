---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import { getProducts, productName, nameFont } from '~/lib/products';
import { displayStatus, displayStatusLabel, displayStatusPill, stageLabel } from '~/lib/taxonomy';
import type { Product } from '~/lib/products';

const products = await getProducts();
const byName = (a: Product, b: Product) => productName(a).localeCompare(productName(b));

// Live products lead as proof — those with a screenshot first, then by stage.
const live = products
  .filter((p) => displayStatus(p.status) === 'live')
  .sort((a, b) => Number(!a.screenshot) - Number(!b.screenshot) || a.stage - b.stage || byName(a, b));

// Everything else is one scannable index: stage, then in-development before planned.
const rest = products
  .filter((p) => displayStatus(p.status) !== 'live')
  .sort(
    (a, b) =>
      a.stage - b.stage ||
      Number(displayStatus(a.status) === 'planned') - Number(displayStatus(b.status) === 'planned') ||
      byName(a, b),
  );

const host = (url?: string) => (url ? new URL(url).host + new URL(url).pathname.replace(/\/$/, '') : null);
const stageShort = (s: Product['stage']) => stageLabel[s].split(' · ')[1];

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://g8suite.com';
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Our Solutions' },
  ],
};
---

<BaseLayout
  title="Our Solutions — g8suite"
  description={`The g8suite lineup — ${products.length} operations products, ${live.length} live in production today.`}
  schemas={[breadcrumbSchema]}
>
  <Nav />
  <main id="main" class="pt-24 lg:pt-28">
    <div class="container-page pb-24">
      <header class="max-w-3xl pb-4 pt-6">
        <h1 class="font-display text-4xl font-bold leading-[1.1] text-body sm:text-5xl">
          One suite, built product by product.
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          {products.length} products across IT, business and industry operations. {live.length} are live in
          production today; the rest are in development or planned. Sovereign, integrated, yours.
        </p>
      </header>

      <!-- Live today -->
      <section id="live" aria-labelledby="live-h" class="mt-12 border-t border-line pt-8">
        <h2 id="live-h" class="font-display text-2xl font-semibold text-body">Live today</h2>
        <ul class="mt-6 grid gap-5 md:grid-cols-2">
          {live.map((p) => (
            <li>
              <a
                href={`/our-solutions/${p.code}`}
                class="group flex h-full flex-col border border-line bg-card transition-colors hover:border-brass focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass focus-visible:ring-offset-2"
              >
                {p.screenshot ? (
                  <img
                    src={p.screenshot}
                    alt=""
                    width="1280"
                    height="720"
                    loading="lazy"
                    decoding="async"
                    class="block aspect-video w-full border-b border-line object-cover"
                  />
                ) : (
                  <div class="grid-ground grid aspect-video place-items-center border-b border-line bg-soft" aria-hidden="true">
                    <span class={`${nameFont(p)} text-4xl font-bold text-body`}>{productName(p)}</span>
                  </div>
                )}
                <div class="flex flex-1 flex-col p-5">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <h3 class={`${nameFont(p)} text-lg font-bold text-body group-hover:text-brass`}>{productName(p)}</h3>
                      {p.alias && <p class="font-mono text-xs text-faint">{p.code}</p>}
                    </div>
                    <span class={displayStatusPill.live}>{displayStatusLabel.live}</span>
                  </div>
                  <p class="mt-2 flex-1 leading-relaxed text-muted">{p.tagline}</p>
                  <div class="mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-sm text-faint">
                    <span>{stageShort(p.stage)} · {p.category}</span>
                    {host(p.domain) && <span class="font-mono text-brass">{host(p.domain)}</span>}
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Building next -->
      <section id="next" aria-labelledby="next-h" class="mt-16 border-t border-line pt-8">
        <h2 id="next-h" class="font-display text-2xl font-semibold text-body">Building next</h2>
        <p class="mt-2 max-w-2xl text-muted">
          In development or planned. Detailed scope and timing are shared with interested organisations directly.
        </p>
        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[36rem] border-collapse text-left">
            <thead>
              <tr class="border-b border-line text-sm text-faint">
                <th scope="col" class="py-2 pr-4 font-medium">Product</th>
                <th scope="col" class="py-2 pr-4 font-medium">What it does</th>
                <th scope="col" class="hidden py-2 pr-4 font-medium md:table-cell">Stage</th>
                <th scope="col" class="py-2 font-medium">Status</th>
              </tr>
            </thead>
            <tbody>
              {rest.map((p) => {
                const ds = displayStatus(p.status);
                return (
                  <tr class="border-b border-line align-top transition-colors hover:bg-soft">
                    <th scope="row" class="w-48 py-3 pr-4 font-normal">
                      <a href={`/our-solutions/${p.code}`} class={`${nameFont(p)} font-semibold text-body hover:text-brass hover:underline`}>
                        {productName(p)}
                      </a>
                      {p.alias && <span class="block font-mono text-xs text-faint">{p.code}</span>}
                    </th>
                    <td class="py-3 pr-4 text-muted">{p.tagline}</td>
                    <td class="hidden whitespace-nowrap py-3 pr-4 text-sm text-faint md:table-cell">{stageShort(p.stage)}</td>
                    <td class="py-3"><span class={displayStatusPill[ds]}>{displayStatusLabel[ds]}</span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
