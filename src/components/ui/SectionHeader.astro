---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  level?: 2 | 3;
}

const { eyebrow, title, subtitle, align = 'left', level = 2 } = Astro.props;
const alignClass = align === 'center' ? 'text-center mx-auto items-center' : 'text-left';
const Heading = `h${level}` as 'h2' | 'h3';
---

<header class={`flex max-w-3xl flex-col ${alignClass}`}>
  {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
  <Heading class="text-3xl font-semibold leading-[1.1] text-paper sm:text-4xl lg:text-5xl">
    {title}
  </Heading>
  {subtitle && (
    <p class="mt-5 text-lg leading-relaxed text-paper-mute">
      {subtitle}
    </p>
  )}
</header>
