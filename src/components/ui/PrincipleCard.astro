---
export interface Props {
  index: number;
  title: string;
  description: string;
}

const { index, title, description } = Astro.props;
const padded = String(index).padStart(2, '0');
---

<article class="flex h-full flex-col border border-panel-line bg-panel p-6 transition-colors hover:border-brass/50">
  <div class="flex items-center gap-3">
    <span class="code text-brass">{padded}</span>
    <span class="h-px flex-1 bg-panel-line"></span>
  </div>
  <h3 class="mt-4 text-lg font-semibold text-paper">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-paper-mute">{description}</p>
</article>
