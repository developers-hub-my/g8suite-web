---
import SectionHeader from '~/components/ui/SectionHeader.astro';
import { getProducts } from '~/lib/products';
import { displayStatus, displayStatusLabel, displayStatusPill } from '~/lib/taxonomy';

const products = await getProducts();

const counts = {
  total: products.length,
  live: products.filter((p) => displayStatus(p.status) === 'live').length,
  inDev: products.filter((p) => displayStatus(p.status) === 'in-dev').length,
  planned: products.filter((p) => displayStatus(p.status) === 'planned').length,
};

// Surface a small, curated set — prefer the `featured` flag, else fall back to
// whatever is live today. Keeps the homepage a teaser, not a full catalogue.
const featured = products.filter((p) => p.featured);
const live = products.filter((p) => displayStatus(p.status) === 'live');
const flagship = (featured.length >= 3 ? featured : live).slice(0, 6);

const stats = [
  { k: 'Products', v: counts.total, tone: 'text-body' },
  { k: 'Live', v: counts.live, tone: 'text-green' },
  { k: 'In development', v: counts.inDev, tone: 'text-brass' },
  { k: 'Planned', v: counts.planned, tone: 'text-muted' },
];
---

<section id="products" class="section bg-soft">
  <div class="container-page">
    <div class="grid items-end gap-8 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <SectionHeader
          eyebrow="The lineup"
          title="One suite. Twenty-five products."
          subtitle="Adopt the products you need today; add the rest as your operating model matures. Every product shares the same identity, audit and workflow spine."
        />
      </div>
      <div class="lg:col-span-4">
        <dl class="grid grid-cols-2 gap-px overflow-hidden border border-line bg-line">
          {stats.map((s) => (
            <div class="bg-card px-4 py-4">
              <dt class="text-xs font-medium text-faint">{s.k}</dt>
              <dd class={`mt-1 font-mono text-2xl font-bold ${s.tone}`}>{s.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {flagship.map((p) => {
        const ds = displayStatus(p.status);
        return (
          <a
            href={`/products/${p.code}`}
            class="group flex h-full flex-col border border-line bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-brass hover:shadow-elevated"
          >
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-mono text-lg font-bold text-body">{p.code}</h3>
              <span class={displayStatusPill[ds]}>{displayStatusLabel[ds]}</span>
            </div>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{p.tagline}</p>
          </a>
        );
      })}
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-4 border-t border-line pt-8 sm:flex-row sm:items-center">
      <p class="max-w-md text-sm text-muted">
        Three stages — IT operations, business operations, and industry applications — all on one sovereign spine.
      </p>
      <a href="/products" class="btn-primary shrink-0">Explore all {counts.total} products →</a>
    </div>
  </div>
</section>
