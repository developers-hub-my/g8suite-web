---
import { getProducts } from '~/lib/products';
import { stageLabel } from '~/lib/taxonomy';

const year = new Date().getFullYear();

const products = await getProducts();

// Products grouped by stage — reads as a structured lineup, not a wall of codes.
const stageGroups = ([1, 2, 3] as const).map((s) => ({
  label: stageLabel[s],
  items: products.filter((p) => p.stage === s),
}));

const platformLinks = [
  { href: '/products', label: 'All products' },
  { href: '/#problem', label: 'Why g8suite' },
  { href: '/#platform', label: 'The platform' },
  { href: '/#built-for', label: 'Who it\'s for' },
  { href: '/#differentiators', label: 'Differentiators' },
];

const companyLinks = [
  { href: 'mailto:hello@devhub.my', label: 'Contact' },
  { href: 'mailto:hello@devhub.my?subject=g8suite%20partner%20enquiry', label: 'Partnerships' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---

<footer class="border-t border-line bg-soft">
  <div class="container-page py-16">
    <div class="grid gap-x-8 gap-y-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href="/" class="inline-flex" aria-label="g8suite home">
          <span class="font-display text-xl font-bold tracking-tight text-body">g8suite</span>
        </a>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-muted">
          The sovereign enterprise operations platform. Built by Developers Hub Sdn Bhd for regulated organisations.
        </p>
        <p class="mt-6 text-sm font-semibold text-body">
          Sovereign. Integrated. Yours.
        </p>
        <address class="mt-6 text-sm not-italic text-muted">
          Developers Hub Sdn Bhd<br />
          Johor Bahru, Malaysia<br />
          <a href="mailto:hello@devhub.my" class="mt-2 inline-block font-medium text-body hover:text-brass">
            hello@devhub.my
          </a>
        </address>
      </div>

      <nav aria-label="Platform" class="lg:col-span-2">
        <p class="text-xs font-semibold uppercase tracking-wider text-faint">Platform</p>
        <ul class="mt-4 space-y-2.5">
          {platformLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted transition-colors hover:text-brass">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Company" class="lg:col-span-2">
        <p class="text-xs font-semibold uppercase tracking-wider text-faint">Company</p>
        <ul class="mt-4 space-y-2.5">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted transition-colors hover:text-brass">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Products" class="lg:col-span-4">
        <div class="flex items-baseline justify-between gap-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-faint">Products</p>
          <a href="/products" class="text-xs font-medium text-body hover:text-brass">All products →</a>
        </div>
        <div class="mt-4 space-y-5">
          {stageGroups.map((group) => (
            <div>
              <p class="text-xs font-medium text-faint">{group.label}</p>
              <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1.5">
                {group.items.map((p) => (
                  <li>
                    <a href={`/products/${p.code}`} class="font-mono text-sm text-muted transition-colors hover:text-brass">
                      {p.code}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </nav>
    </div>

    <div class="mt-14 flex flex-col items-start gap-3 border-t border-line pt-8 md:flex-row md:items-center md:justify-between">
      <p class="text-xs text-faint">
        © {year} Developers Hub Sdn Bhd. All rights reserved.
      </p>
      <p class="text-xs text-faint">
        Built in Johor Bahru — for organisations that own their stack.
      </p>
    </div>
  </div>
</footer>
