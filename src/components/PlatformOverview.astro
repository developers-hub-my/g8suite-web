---
import SectionHeader from '~/components/ui/SectionHeader.astro';
import { getProducts } from '~/lib/products';

const total = (await getProducts()).length;

const pillars = [
  {
    title: 'One Platform',
    body: 'A single, coherent system replacing dozens of disconnected tools — designed and built as one suite, not assembled from acquisitions.',
  },
  {
    title: 'Clear Accountability',
    body: 'A single, accountable partnership across the whole operations stack — one contract, one SLA, one point of contact. No finger-pointing between suppliers when something needs owning.',
  },
  {
    title: 'One Source of Truth',
    body: 'Deployed inside your perimeter. Answerable to you — not a cloud provider. Identity, audit, and operations live where your data lives.',
  },
];
---

<section id="platform" class="section bg-soft">
  <div class="container-page">
    <SectionHeader
      eyebrow="The platform"
      title="One suite that completes your operations ecosystem."
      subtitle={`Identity, audit and workflow at the core; ${total} products across IT, business and industry operations on top. Everything your organisation runs on — built as one, not assembled from a dozen vendors.`}
    />

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {pillars.map((pillar) => (
        <div class="border border-line bg-card p-7">
          <h3 class="text-xl font-semibold text-body">{pillar.title}</h3>
          <p class="mt-3 text-base leading-relaxed text-muted">{pillar.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
