---
import SectionHeader from '~/components/ui/SectionHeader.astro';

const listify = (xs: string[]) =>
  xs.length <= 1 ? (xs[0] ?? '') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`;

// Curated proof list for "products that stand on their own" — hand-picked, not
// derived from the catalogue, because the marketing selection here diverges from
// product frontmatter (g8stack.com is featured; waumail.my is not). Live rows
// must be genuinely live in production — the copy claims it.
const branded: { name: string; live: boolean }[] = [
  { name: 'g8stack.com', live: true },
  { name: 'gatherhub.app', live: true },
  { name: 'nadi.pro', live: true },
  { name: 'kajian.space', live: false },
  { name: 'warung.my', live: false },
];
const liveNames = branded.filter((b) => b.live).map((b) => b.name);

interface Item {
  title: string;
  lede: string;
  body: string;
  bullets: string[];
  diagram: 'perimeter' | 'built-as-one' | 'standalone' | 'pricing';
}

const items: Item[] = [
  {
    title: 'Designed as one, not assembled from acquisitions',
    lede: 'One team, one system',
    body: 'Most enterprise suites are assembled — products bought from different companies and bolted together, each arriving with its own data model, its own directory, and seams nobody ever removes. g8suite was designed and built as one system by one team. There are no acquired seams to work around, because there were never any acquisitions.',
    bullets: ['Built by one team', 'One identity model', 'No acquired seams'],
    diagram: 'built-as-one',
  },
  {
    title: 'The whole suite runs inside your perimeter',
    lede: 'Air-gappable, not just self-hosted',
    body: 'Not one module you may self-host while the rest phones home. Every product is deployed inside your perimeter and runs disconnected from the public internet when your operating doctrine demands it. No phone-home telemetry. No vendor backdoors.',
    bullets: ['Air-gap supported', 'No phone-home', 'No shared multi-tenant surfaces'],
    diagram: 'perimeter',
  },
  {
    title: 'Products that stand on their own',
    lede: 'Proof, not promise',
    body: `${listify(liveNames)} are live in production today — built in the suite, sold under their own brands, on their own domains, to their own markets. A platform that can carry independent products is a platform that will not trap yours.`,
    bullets: ['Live under their own brands', 'Own domains, own markets', 'Nothing forced inward'],
    diagram: 'standalone',
  },
  {
    title: 'Priced per deployment, not per user',
    lede: 'No per-seat tax',
    body: 'No per-seat pricing that punishes growth. No surprise bills when your headcount changes. One predictable platform fee per deployment — the same whether ten people use it or ten thousand.',
    bullets: ['Predictable pricing', 'Headcount-neutral', 'Per-environment licensing'],
    diagram: 'pricing',
  },
];
---

<section id="differentiators" class="section">
  <div class="container-page">
    <SectionHeader
      eyebrow="Differentiators"
      title="What makes g8suite different"
      subtitle="Four differences a competitor cannot close by rewriting their website. Each one comes from how the suite was built, not how it is sold."
    />

    <div class="mt-16 space-y-16 lg:space-y-24">
      {items.map((item, i) => {
        const padded = String(i + 1).padStart(2, '0');
        const reverse = i % 2 === 1;
        return (
          <article class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
            <div class={`lg:col-span-7 ${reverse ? 'lg:order-2' : ''}`}>
              <div class="flex items-center gap-4">
                <span class="font-mono text-5xl font-bold leading-none text-brass lg:text-6xl">
                  {padded}
                </span>
                <span class="h-px flex-1 bg-line"></span>
                <span class="text-xs font-semibold uppercase tracking-[0.14em] text-faint">
                  {item.lede}
                </span>
              </div>
              <h3 class="mt-6 text-2xl font-semibold leading-tight text-body sm:text-3xl">
                {item.title}
              </h3>
              <p class="mt-4 text-base leading-relaxed text-muted lg:text-lg">
                {item.body}
              </p>
              <ul class="mt-6 grid gap-3 sm:grid-cols-3">
                {item.bullets.map((b) => (
                  <li class="flex items-start gap-2 text-sm text-body">
                    <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-green" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M3 8l3.5 3.5L13 4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="font-medium">{b}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class={`lg:col-span-5 ${reverse ? 'lg:order-1' : ''}`}>
              <figure class="border border-line bg-card p-8 lg:p-10">
                {item.diagram === 'perimeter' && (
                  <svg viewBox="0 0 320 240" class="h-auto w-full" aria-hidden="true">
                    <rect x="20" y="20" width="280" height="200" rx="10" fill="none" class="stroke-brass" stroke-width="1.5" stroke-dasharray="6 6" />
                    <g class="stroke-body" stroke-width="2" fill="none">
                      <path d="M20 40 L20 20 L40 20" />
                      <path d="M300 40 L300 20 L280 20" />
                      <path d="M20 200 L20 220 L40 220" />
                      <path d="M300 200 L300 220 L280 220" />
                    </g>
                    <text x="160" y="14" text-anchor="middle" font-size="9" font-family="ui-monospace, monospace" class="fill-faint" letter-spacing="0.14em">YOUR PERIMETER</text>
                    <g>
                      <rect x="80" y="80" width="160" height="20" rx="3" class="fill-body" />
                      <rect x="80" y="110" width="160" height="20" rx="3" class="fill-line-strong" />
                      <rect x="80" y="140" width="160" height="20" rx="3" class="fill-line" />
                      <circle cx="100" cy="90" r="3" class="fill-brass" />
                      <circle cx="100" cy="120" r="3" class="fill-brass" />
                      <circle cx="100" cy="150" r="3" class="fill-brass" />
                    </g>
                    <text x="160" y="190" text-anchor="middle" font-size="10" font-family="ui-monospace, monospace" class="fill-faint">no phone-home · no backdoor</text>
                  </svg>
                )}

                {item.diagram === 'built-as-one' && (
                  <svg viewBox="0 0 320 240" class="h-auto w-full" aria-hidden="true">
                    {/* Left: assembled — mismatched blocks, visible seams */}
                    {[
                      { x: 12, y: 50, w: 56, h: 28, f: 'fill-card' },
                      { x: 76, y: 44, w: 62, h: 22, f: 'fill-soft' },
                      { x: 16, y: 88, w: 40, h: 34, f: 'fill-line' },
                      { x: 64, y: 80, w: 74, h: 26, f: 'fill-card' },
                      { x: 22, y: 132, w: 58, h: 24, f: 'fill-soft' },
                      { x: 88, y: 126, w: 50, h: 34, f: 'fill-line' },
                      { x: 14, y: 172, w: 76, h: 22, f: 'fill-card' },
                    ].map((b) => (
                      <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="2" class={`${b.f} stroke-line-strong`} stroke-width="1" />
                    ))}
                    {[
                      [68, 64, 76, 55],
                      [56, 105, 64, 93],
                      [80, 144, 88, 143],
                      [90, 183, 98, 160],
                    ].map(([x1, y1, x2, y2]) => (
                      <line x1={x1} y1={y1} x2={x2} y2={y2} class="stroke-faint" stroke-width="1" stroke-dasharray="2 2" />
                    ))}
                    <text x="76" y="216" text-anchor="middle" font-size="8" font-family="ui-monospace, monospace" class="fill-faint">Assembled from parts</text>

                    <line x1="160" y1="40" x2="160" y2="196" class="stroke-line" stroke-width="1" />

                    {/* Right: designed — one grid, every tile alike */}
                    {[0, 1, 2, 3].map((row) =>
                      [0, 1, 2].map((col) => (
                        <rect
                          x={178 + col * 46}
                          y={50 + row * 38}
                          width="42"
                          height="30"
                          rx="2"
                          class="fill-card stroke-brass"
                          stroke-width="1"
                        />
                      )),
                    )}
                    <text x="240" y="216" text-anchor="middle" font-size="8" font-family="ui-monospace, monospace" class="fill-faint">Designed as one</text>
                  </svg>
                )}

                {item.diagram === 'standalone' && (
                  <svg viewBox="0 0 320 240" class="h-auto w-full" aria-hidden="true">
                    <text x="160" y="22" text-anchor="middle" font-size="9" font-family="ui-monospace, monospace" class="fill-faint">Their own brands, their own markets</text>
                    {branded.map((p, i) => {
                      const y = 40 + i * 34;
                      return (
                        <g>
                          <rect
                            x="8"
                            y={y}
                            width="304"
                            height="28"
                            rx="3"
                            class={p.live ? 'fill-card stroke-brass' : 'fill-soft stroke-line-strong'}
                            stroke-width="1"
                            stroke-dasharray={p.live ? undefined : '4 3'}
                          />
                          <text x="18" y={y + 18} font-size="10" font-weight="600" font-family="ui-monospace, monospace" class={p.live ? 'fill-brass' : 'fill-faint'}>{p.name}</text>
                          <text x="302" y={y + 18} text-anchor="end" font-size="8" font-family="Inter, system-ui, sans-serif" class={p.live ? 'fill-green' : 'fill-faint'}>{p.live ? 'Live' : 'In development'}</text>
                        </g>
                      );
                    })}
                    <text x="160" y="228" text-anchor="middle" font-size="8" font-family="ui-monospace, monospace" class="fill-faint">Built in g8suite · sold standalone</text>
                  </svg>
                )}

                {item.diagram === 'pricing' && (
                  <svg viewBox="0 0 320 240" class="h-auto w-full" aria-hidden="true">
                    {/* Axes: cost (y) against headcount (x) */}
                    <line x1="44" y1="24" x2="44" y2="196" class="stroke-line-strong" stroke-width="1.25" />
                    <line x1="44" y1="196" x2="300" y2="196" class="stroke-line-strong" stroke-width="1.25" />
                    <text x="40" y="18" font-size="8" font-family="ui-monospace, monospace" class="fill-faint">Cost</text>
                    <text x="300" y="214" text-anchor="end" font-size="8" font-family="ui-monospace, monospace" class="fill-faint">Headcount →</text>

                    {/* Per seat — climbs with every added user */}
                    <line x1="44" y1="196" x2="286" y2="44" class="stroke-line-strong" stroke-width="1.75" stroke-dasharray="4 3" />
                    <circle cx="286" cy="44" r="3" class="fill-line-strong" />
                    <text x="282" y="40" text-anchor="end" font-size="10" font-weight="600" font-family="Inter, system-ui, sans-serif" class="fill-body">Per seat</text>
                    <text x="282" y="54" text-anchor="end" font-size="8" font-family="ui-monospace, monospace" class="fill-faint">rises with headcount</text>

                    {/* Per deployment — one flat fee, whatever the headcount */}
                    <line x1="44" y1="150" x2="286" y2="150" class="stroke-brass" stroke-width="2.5" />
                    <circle cx="286" cy="150" r="3" class="fill-brass" />
                    <text x="212" y="142" text-anchor="middle" font-size="10" font-weight="600" font-family="Inter, system-ui, sans-serif" class="fill-brass">Per deployment</text>
                    <text x="212" y="166" text-anchor="middle" font-size="8" font-family="ui-monospace, monospace" class="fill-faint">flat — predictable</text>
                  </svg>
                )}
              </figure>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
