---
import SectionHeader from '~/components/ui/SectionHeader.astro';

interface Item {
  title: string;
  lede: string;
  body: string;
  bullets: string[];
  diagram: 'perimeter' | 'converge' | 'foundation' | 'stack' | 'scales';
}

const items: Item[] = [
  {
    title: 'On-premise, air-gappable, your infrastructure',
    lede: 'Sovereign by deployment',
    body: 'Deployed inside your perimeter. Runs disconnected from the public internet when your operating doctrine demands it. No phone-home telemetry. No vendor backdoors.',
    bullets: ['Air-gap supported', 'No phone-home', 'No shared multi-tenant surfaces'],
    diagram: 'perimeter',
  },
  {
    title: 'A single line of accountability',
    lede: 'Clear ownership',
    body: 'One accountable partnership for the entire operations stack — one contract to negotiate, one SLA to enforce, one team to call. No finger-pointing between suppliers when something needs owning.',
    bullets: ['One accountable partnership', 'One SLA', 'One escalation path'],
    diagram: 'converge',
  },
  {
    title: 'Governance-first architecture',
    lede: 'Built in, not bolted on',
    body: 'Identity governance, audit, and policy enforcement are not added after the fact. Every product in the suite is built with them from the start — one identity model, one audit trail, one workflow, across the whole ecosystem.',
    bullets: ['IGA-grade identity', 'Unified audit trail', 'Cross-product workflow'],
    diagram: 'foundation',
  },
  {
    title: 'Grows with your organisation',
    lede: 'Adopt at your pace',
    body: 'Start with the products you need today. Add the rest as your operating model matures. The platform scales horizontally because every product is built the same way, as part of the same suite.',
    bullets: ['Adopt incrementally', 'No re-platform later', 'One suite, every product'],
    diagram: 'stack',
  },
  {
    title: 'Priced per deployment, not per user',
    lede: 'No per-seat tax',
    body: 'No per-seat pricing that punishes growth. No surprise bills when your headcount changes. One predictable platform fee per deployment.',
    bullets: ['Predictable pricing', 'Headcount-neutral', 'Per-environment licensing'],
    diagram: 'scales',
  },
];
---

<section id="differentiators" class="section">
  <div class="container-page">
    <SectionHeader
      eyebrow="Differentiators"
      title="What makes g8suite different"
      subtitle="Five differentiators that come from building a platform, not assembling point tools."
    />

    <div class="mt-16 space-y-16 lg:space-y-24">
      {items.map((item, i) => {
        const padded = String(i + 1).padStart(2, '0');
        const reverse = i % 2 === 1;
        return (
          <article class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
            <div class={`lg:col-span-7 ${reverse ? 'lg:order-2' : ''}`}>
              <div class="flex items-center gap-4">
                <span class="font-mono text-5xl font-bold leading-none text-brass lg:text-6xl">
                  {padded}
                </span>
                <span class="h-px flex-1 bg-line"></span>
                <span class="text-xs font-semibold uppercase tracking-[0.14em] text-faint">
                  {item.lede}
                </span>
              </div>
              <h3 class="mt-6 text-2xl font-semibold leading-tight text-body sm:text-3xl">
                {item.title}
              </h3>
              <p class="mt-4 text-base leading-relaxed text-muted lg:text-lg">
                {item.body}
              </p>
              <ul class="mt-6 grid gap-3 sm:grid-cols-3">
                {item.bullets.map((b) => (
                  <li class="flex items-start gap-2 text-sm text-body">
                    <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-green" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M3 8l3.5 3.5L13 4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="font-medium">{b}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class={`lg:col-span-5 ${reverse ? 'lg:order-1' : ''}`}>
              <figure class="border border-line bg-card p-8 lg:p-10">
                {item.diagram === 'perimeter' && (
                  <svg viewBox="0 0 320 240" class="h-auto w-full" aria-hidden="true">
                    <rect x="20" y="20" width="280" height="200" rx="10" fill="none" class="stroke-brass" stroke-width="1.5" stroke-dasharray="6 6" />
                    <g class="stroke-body" stroke-width="2" fill="none">
                      <path d="M20 40 L20 20 L40 20" />
                      <path d="M300 40 L300 20 L280 20" />
                      <path d="M20 200 L20 220 L40 220" />
                      <path d="M300 200 L300 220 L280 220" />
                    </g>
                    <text x="160" y="14" text-anchor="middle" font-size="9" font-family="ui-monospace, monospace" class="fill-faint" letter-spacing="0.14em">YOUR PERIMETER</text>
                    <g>
                      <rect x="80" y="80" width="160" height="20" rx="3" class="fill-body" />
                      <rect x="80" y="110" width="160" height="20" rx="3" class="fill-line-strong" />
                      <rect x="80" y="140" width="160" height="20" rx="3" class="fill-line" />
                      <circle cx="100" cy="90" r="3" class="fill-brass" />
                      <circle cx="100" cy="120" r="3" class="fill-brass" />
                      <circle cx="100" cy="150" r="3" class="fill-brass" />
                    </g>
                    <text x="160" y="190" text-anchor="middle" font-size="10" font-family="ui-monospace, monospace" class="fill-faint">no phone-home · no backdoor</text>
                  </svg>
                )}

                {item.diagram === 'converge' && (
                  <svg viewBox="0 0 320 240" class="h-auto w-full" aria-hidden="true">
                    {[40, 80, 120, 160, 200].map((y) => (
                      <g>
                        <rect x="20" y={y - 10} width="60" height="20" rx="3" class="fill-card stroke-faint" stroke-width="1" />
                        <line x1="80" y1={y} x2="200" y2="120" class="stroke-brass" stroke-width="1" stroke-dasharray="2 3" />
                      </g>
                    ))}
                    <rect x="200" y="100" width="100" height="40" rx="6" class="fill-brass" />
                    <text x="250" y="125" text-anchor="middle" font-size="11" font-weight="600" class="fill-brass-on" font-family="ui-monospace, monospace">g8suite</text>
                    <text x="50" y="220" text-anchor="middle" font-size="9" font-family="ui-monospace, monospace" class="fill-faint">Many suppliers</text>
                    <text x="250" y="220" text-anchor="middle" font-size="9" font-family="ui-monospace, monospace" class="fill-faint">One partnership</text>
                  </svg>
                )}

                {item.diagram === 'foundation' && (
                  <svg viewBox="0 0 320 240" class="h-auto w-full" aria-hidden="true">
                    <text x="160" y="16" text-anchor="middle" font-size="9" font-family="ui-monospace, monospace" class="fill-faint">Shared by every product</text>
                    {[
                      { x: 150, l: 'Identity' },
                      { x: 215, l: 'Audit' },
                      { x: 280, l: 'Workflow' },
                    ].map((c) => (
                      <text x={c.x} y="38" text-anchor="middle" font-size="8" font-family="ui-monospace, monospace" class="fill-faint">{c.l}</text>
                    ))}
                    <line x1="5" y1="44" x2="315" y2="44" class="stroke-line-strong" stroke-width="1" />
                    {['g8stack', 'g8shield', 'g8connect', 'g8scope', 'g8hr', 'g8desk'].map((l, i) => {
                      const y = 52 + i * 30;
                      const cy = y + 15;
                      return (
                        <g>
                          {i > 0 && <line x1="5" y1={y} x2="315" y2={y} class="stroke-line" stroke-width="1" />}
                          <text x="8" y={cy + 3} font-size="8" font-family="ui-monospace, monospace" class="fill-body">{l}</text>
                          {[150, 215, 280].map((x) => (
                            <path
                              d={`M${x - 4} ${cy} l3 3 l6 -7`}
                              class="stroke-brass"
                              stroke-width="1.5"
                              fill="none"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          ))}
                        </g>
                      );
                    })}
                  </svg>
                )}

                {item.diagram === 'stack' && (
                  <svg viewBox="0 0 320 240" class="h-auto w-full" aria-hidden="true">
                    {[
                      { y: 200, w: 280, fill: 'fill-card', label: 'Platform', text: 'fill-body' },
                      { y: 160, w: 240, fill: 'fill-soft', label: 'Operations', text: 'fill-body' },
                      { y: 120, w: 200, fill: 'fill-line-strong', label: 'Trust', text: 'fill-body' },
                      { y: 80, w: 160, fill: 'fill-brass', label: 'Apex', text: 'fill-brass-on' },
                    ].map((b) => (
                      <g>
                        <rect x={(320 - b.w) / 2} y={b.y} width={b.w} height="30" rx="3" class={`${b.fill} stroke-line-strong`} stroke-width="1.25" />
                        <text x="160" y={b.y + 19} text-anchor="middle" font-size="11" font-weight="600" class={b.text} font-family="Inter, system-ui, sans-serif">{b.label}</text>
                      </g>
                    ))}
                    <text x="160" y="55" text-anchor="middle" font-size="10" font-family="ui-monospace, monospace" class="fill-faint" letter-spacing="0.12em">ADD UP, NOT REPLATFORM</text>
                  </svg>
                )}

                {item.diagram === 'scales' && (
                  <svg viewBox="0 0 320 240" class="h-auto w-full" aria-hidden="true">
                    <line x1="40" y1="60" x2="280" y2="60" class="stroke-body" stroke-width="1.5" />
                    <line x1="160" y1="60" x2="160" y2="200" class="stroke-body" stroke-width="1.5" />
                    <polygon points="140,200 180,200 175,210 145,210" class="fill-body" />
                    <line x1="60" y1="60" x2="60" y2="100" class="stroke-body" stroke-width="1" />
                    <line x1="260" y1="60" x2="260" y2="80" class="stroke-body" stroke-width="1" />
                    <rect x="20" y="100" width="80" height="40" rx="3" class="fill-line-strong" />
                    <text x="60" y="125" text-anchor="middle" font-size="10" font-weight="600" class="fill-body" font-family="Inter, system-ui, sans-serif">Per seat</text>
                    <text x="60" y="155" text-anchor="middle" font-size="9" font-family="ui-monospace, monospace" class="fill-faint">scales w/ headcount</text>
                    <rect x="220" y="80" width="80" height="20" rx="3" class="fill-brass" />
                    <text x="260" y="95" text-anchor="middle" font-size="10" font-weight="600" class="fill-brass-on" font-family="Inter, system-ui, sans-serif">Per deployment</text>
                    <text x="260" y="120" text-anchor="middle" font-size="9" font-family="ui-monospace, monospace" class="fill-faint">predictable</text>
                  </svg>
                )}
              </figure>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
