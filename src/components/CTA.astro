---
const actions = [
  {
    n: '01',
    title: 'Request a Demo',
    body: 'See g8suite in a regulated deployment context — built around your sovereignty and compliance requirements.',
    href: 'mailto:hello@devhub.my?subject=g8suite%20demo%20request',
    cta: 'Book a demo',
  },
  {
    n: '02',
    title: 'Become a Partner',
    body: 'Join the anchored partner network across ASEAN, MENA, and aligned sovereignty markets.',
    href: 'mailto:hello@devhub.my?subject=g8suite%20partner%20enquiry',
    cta: 'Talk partnerships',
  },
  {
    n: '03',
    title: 'Start a Conversation',
    body: 'Not ready for a demo? Tell us what you\'re working on — we\'ll respond within one business day.',
    href: 'mailto:hello@devhub.my',
    cta: 'hello@devhub.my',
  },
];
---

<section id="contact" class="section">
  <div class="container-page">
    <div class="perimeter bg-soft">
      <span class="corner-bl" aria-hidden="true"></span>
      <span class="corner-br" aria-hidden="true"></span>

      <div class="grid gap-12 p-8 lg:grid-cols-12 lg:gap-16 lg:p-14">
        <header class="lg:col-span-6">
          <p class="eyebrow mb-5">Contact</p>
          <h2 class="text-3xl font-bold leading-[1.05] text-body sm:text-4xl lg:text-5xl">
            Ready to consolidate your stack?
          </h2>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
            Let's talk about what g8suite looks like inside your organisation — your perimeter, your compliance posture, your operating doctrine.
          </p>
          <p class="mt-10 text-2xl font-bold text-body">
            Sovereign. <span class="text-brass">Integrated.</span> Yours.
          </p>
        </header>

        <div class="lg:col-span-6">
          <div class="grid gap-3">
            {actions.map((action) => (
              <a
                href={action.href}
                class="group flex items-center justify-between gap-6 border border-line bg-card p-6 transition-colors hover:border-brass"
              >
                <div class="flex items-start gap-5">
                  <span class="font-mono text-sm font-semibold text-brass">{action.n}</span>
                  <div>
                    <h3 class="text-base font-semibold text-body">{action.title}</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-muted">{action.body}</p>
                    <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-medium text-brass">
                      {action.cta}
                    </span>
                  </div>
                </div>
                <svg class="h-5 w-5 flex-shrink-0 text-brass transition-transform group-hover:translate-x-1" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M2 7h10M8 3l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
