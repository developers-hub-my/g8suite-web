---
import SectionHeader from '~/components/ui/SectionHeader.astro';
import { getStageProducts } from '~/lib/products';
import { displayStatus, displayStatusLabel, displayStatusPill } from '~/lib/taxonomy';

const products = await getStageProducts(1);

const liveCount = products.filter((p) => displayStatus(p.status) === 'live').length;
const devCount = products.filter((p) => displayStatus(p.status) === 'in-dev').length;
const plannedCount = products.filter((p) => displayStatus(p.status) === 'planned').length;
---

<section id="products" class="section bg-soft">
  <div class="container-page">
    <div class="grid items-end gap-8 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <SectionHeader
          eyebrow="Stage 1 — IT Operations"
          title={`${products.length} products. One integrated platform.`}
          subtitle="The IT operations layer of the ecosystem. Adopt the products you need today, add the rest as your operating model matures."
        />
      </div>
      <div class="lg:col-span-4">
        <dl class="grid grid-cols-3 gap-4 rounded-xl border border-line bg-card p-5 text-center">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-faint">Live</dt>
            <dd class="mt-1 font-mono text-2xl font-bold text-green">{liveCount}</dd>
          </div>
          <div class="border-x border-line">
            <dt class="text-xs font-semibold uppercase tracking-wider text-faint">In dev</dt>
            <dd class="mt-1 font-mono text-2xl font-bold text-brass">{devCount}</dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-faint">Planned</dt>
            <dd class="mt-1 font-mono text-2xl font-bold text-faint">{plannedCount}</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {products.map((p) => (
        <a
          href={`/products/${p.code}`}
          class={`group relative flex h-full flex-col rounded-xl border p-6 transition-all hover:-translate-y-0.5 hover:shadow-elevated ${
            p.status === 'live'
              ? 'border-brass/40 bg-card ring-1 ring-brass/10'
              : 'border-line bg-card hover:border-brass'
          }`}
        >
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-wider text-faint">{p.category}</p>
              <h3 class="mt-1.5 font-mono text-xl font-bold text-body">{p.code}</h3>
            </div>
            <span class={displayStatusPill[displayStatus(p.status)]}>{displayStatusLabel[displayStatus(p.status)]}</span>
          </div>
          <p class="mt-4 flex-1 text-sm leading-relaxed text-muted">{p.tagline}</p>
          <span class="mt-5 inline-flex items-center gap-1.5 border-t border-line pt-4 text-xs font-medium text-body">
            View details
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
              <path d="M2 7h10M8 3l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      ))}
    </div>

    <p class="mt-8 text-sm text-muted">
      <a href="/products" class="inline-flex items-center gap-1.5 font-medium text-body hover:text-brass">
        See the full lineup
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M2 7h10M8 3l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </p>
  </div>
</section>
