---
const primaryLinks = [
  { href: '/products', label: 'Solutions' },
  { href: '/why-g8suite', label: 'Why g8suite' },
  { href: '/#built-for', label: 'Who it\'s for' },
];
---

<header
  data-nav
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent bg-transparent transition-colors duration-200"
>
  <div class="container-page flex h-16 items-center justify-between lg:h-[76px]">
    <a href="/" class="inline-flex items-center" aria-label="g8suite home">
      <span class="font-display text-[20px] font-bold leading-none tracking-tight text-body">g8suite</span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {primaryLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-md px-3 py-2 text-[15px] font-medium text-muted transition-colors hover:text-body"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <button
        type="button"
        data-theme-toggle
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-line text-muted transition-colors hover:border-brass hover:text-body"
        aria-label="Toggle colour theme"
      >
        <svg data-theme-icon-sun class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg data-theme-icon-moon class="block h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
      <a href="/#contact" class="btn-primary">Request a Demo</a>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <button
        type="button"
        data-theme-toggle
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-line text-muted transition-colors hover:border-brass hover:text-body"
        aria-label="Toggle colour theme"
      >
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="block h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
      <button
        type="button"
        data-nav-toggle
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-line text-body transition-colors hover:border-brass"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg data-nav-icon-open xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <line x1="4" x2="20" y1="7" y2="7"></line>
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="17" y2="17"></line>
        </svg>
        <svg data-nav-icon-close class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <line x1="18" x2="6" y1="6" y2="18"></line>
          <line x1="6" x2="18" y1="6" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-nav"
    data-nav-menu
    hidden
    class="lg:hidden border-t border-line bg-bg max-h-[calc(100vh-4rem)] overflow-y-auto"
  >
    <nav aria-label="Mobile" class="container-page py-6">
      <ul class="flex flex-col">
        {primaryLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-close
              class="block border-b border-line py-3 text-base font-medium text-muted hover:text-body"
            >
              {link.label}
            </a>
          </li>
        ))}
        <li class="pt-5">
          <a href="/#contact" data-nav-close class="btn-primary w-full">Request a Demo</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  if (header) {
    const toggleBtn = header.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const menu = header.querySelector<HTMLElement>('[data-nav-menu]');
    const iconOpen = header.querySelector<SVGElement>('[data-nav-icon-open]');
    const iconClose = header.querySelector<SVGElement>('[data-nav-icon-close]');
    const closers = header.querySelectorAll<HTMLAnchorElement>('[data-nav-close]');

    const chromeOn = [
      'bg-bg/95',
      'border-line',
      'backdrop-blur',
      'supports-[backdrop-filter]:bg-bg/80',
    ];
    const chromeOff = ['bg-transparent', 'border-transparent'];

    let mobileOpen = false;

    const updateChrome = () => {
      const scrolled = window.scrollY > 24;
      if (scrolled || mobileOpen) {
        header.classList.add(...chromeOn);
        header.classList.remove(...chromeOff);
      } else {
        header.classList.add(...chromeOff);
        header.classList.remove(...chromeOn);
      }
    };

    const setMobile = (value: boolean) => {
      mobileOpen = value;
      toggleBtn?.setAttribute('aria-expanded', String(value));
      menu?.toggleAttribute('hidden', !value);
      iconOpen?.classList.toggle('hidden', value);
      iconClose?.classList.toggle('hidden', !value);
      updateChrome();
    };

    toggleBtn?.addEventListener('click', () => setMobile(!mobileOpen));
    closers.forEach((el) => el.addEventListener('click', () => setMobile(false)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileOpen) setMobile(false);
    });

    window.addEventListener('scroll', updateChrome, { passive: true });
    updateChrome();

    // Theme toggle — persists choice; light is the default face.
    const themeBtns = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    themeBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (e) {}
        if (meta) meta.setAttribute('content', isDark ? '#0A1628' : '#FCFCFA');
      }),
    );
  }
</script>
