---
import SectionHeader from '~/components/ui/SectionHeader.astro';
import { getStageProducts } from '~/lib/products';
import { displayStatus, displayStatusLabel, displayStatusPill } from '~/lib/taxonomy';

const products = await getStageProducts(2);
---

<section id="stage-2" class="section">
  <div class="container-page">
    <SectionHeader
      eyebrow="Stage 2 — Business Operations"
      title={`${products.length} products on the shared spine.`}
      subtitle="Business operations products that ride the mature Stage 1 spine — sharing identity, audit and workflow rather than re-platforming."
    />

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p) => (
        <a
          href={`/products/${p.code}`}
          class="group flex h-full flex-col rounded-xl border border-line bg-card p-6 transition-all hover:-translate-y-0.5 hover:border-brass hover:shadow-elevated"
        >
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-wider text-faint">{p.category}</p>
              <h3 class="mt-1.5 font-mono text-lg font-bold text-body">{p.code}</h3>
            </div>
            <span class={displayStatusPill[displayStatus(p.status)]}>{displayStatusLabel[displayStatus(p.status)]}</span>
          </div>
          <p class="mt-4 flex-1 text-sm leading-relaxed text-muted">{p.tagline}</p>
        </a>
      ))}
    </div>

    <div class="mt-14 rounded-2xl border border-line bg-card-2 p-8 text-body lg:p-10">
      <p class="text-base leading-relaxed lg:text-xl">
        Shared identity through <span class="font-mono text-brass">G8ID</span>. Shared audit through <span class="font-mono text-brass">g8audit</span>. Shared workflow through <span class="font-mono text-brass">g8flow</span>.
      </p>
      <p class="mt-3 text-base leading-relaxed text-muted lg:text-lg">
        One spine. New capabilities. No re-platform.
      </p>
    </div>
  </div>
</section>
