---
import { getProducts } from '~/lib/products';

const products = await getProducts();
const total = products.length;

// Coverage, derived from the collection — the whole ecosystem, not a core.
const domains = [
  { label: 'IT Operations', note: 'The software your organisation runs on', stage: 1 },
  { label: 'Business Operations', note: 'How the organisation runs, day to day', stage: 2 },
  { label: 'Industry Applications', note: 'Built for your sector, on your terms', stage: 3 },
].map((d) => ({ ...d, count: products.filter((p) => p.stage === d.stage).length }));

const readout = [
  { k: 'Deployment', v: 'On-prem / air-gapped' },
  { k: 'Ecosystem', v: `${total} products, one suite` },
  { k: 'Coverage', v: 'IT, business & industry' },
];
---

<section id="top" class="relative overflow-hidden pt-24 pb-16 lg:pt-28 lg:pb-24">
  <!-- Blueprint ground: faint grid, static, theme-aware -->
  <div class="grid-ground pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    aria-hidden="true"
    style="background: radial-gradient(900px 480px at 78% -5%, rgb(var(--brass) / 0.08), transparent 60%);"
  ></div>

  <div class="container-page">
    <div data-hero class="perimeter bg-soft/50">
      <span class="corner-bl" aria-hidden="true"></span>
      <span class="corner-br" aria-hidden="true"></span>

      <!-- Title block / top rail of the perimeter -->
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-line px-5 py-3.5 lg:px-8">
        <p class="text-sm font-medium text-muted">Sovereign Operations · g8suite</p>
        <div class="flex items-center gap-x-5 gap-y-1">
          <span class="code text-faint">01°28′N&nbsp;103°45′E · Johor Bahru</span>
          <span class="inline-flex items-center gap-2 text-sm font-medium text-muted">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-green"></span>
            Operational
          </span>
        </div>
      </div>

      <div class="grid gap-y-10 px-5 py-10 lg:grid-cols-12 lg:items-center lg:gap-x-10 lg:px-8 lg:py-14">
        <!-- Left: thesis -->
        <div class="lg:col-span-7">
          <p class="eyebrow mb-6">Sovereign · Integrated · Yours</p>

          <h1 class="text-[2.6rem] font-bold leading-[1.02] tracking-tight text-body sm:text-6xl lg:text-[4.2rem]">
            Run your whole operation<br class="hidden sm:block" />
            inside <span class="text-brass">your own walls.</span>
          </h1>

          <p class="mt-7 max-w-xl text-lg leading-relaxed text-muted">
            An integrated operations suite for regulated organisations — designed and
            built as one system, and run entirely inside your perimeter. Answerable to
            you, not to a cloud provider.
          </p>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="#contact" class="btn-primary">Request a Demo</a>
            <a href="#platform" class="btn-ghost">Explore the Platform →</a>
          </div>
        </div>

        <!-- Right: the coverage of the ecosystem, rendered as an instrument -->
        <div class="lg:col-span-5">
          <div class="border border-line bg-card">
            <div class="flex items-center justify-between border-b border-line px-4 py-3">
              <span class="text-sm font-semibold text-body">The Ecosystem</span>
              <span class="mono-label">{total} products</span>
            </div>
            <ul>
              {domains.map((d, i) => (
                <li class={`flex items-center gap-4 px-4 py-4 ${i > 0 ? 'border-t border-line' : ''}`}>
                  <span class="base-tick pl-4"></span>
                  <div class="min-w-0 flex-1">
                    <p class="font-display text-lg font-semibold leading-none text-body">{d.label}</p>
                    <p class="mt-1.5 text-[13px] text-muted">{d.note}</p>
                  </div>
                  <span class="code">{d.count}</span>
                </li>
              ))}
            </ul>
            <div class="border-t border-line bg-soft px-4 py-3">
              <span class="mono-label">Adopt what you need — inside your perimeter</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom rail: readout -->
      <dl class="grid grid-cols-1 border-t border-line sm:grid-cols-3">
        {readout.map((r, i) => (
          <div class={`px-5 py-4 lg:px-8 ${i > 0 ? 'border-t border-line sm:border-l sm:border-t-0' : ''}`}>
            <dt class="mono-label">{r.k}</dt>
            <dd class="mt-1.5 text-[15px] font-semibold text-body">{r.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<script>
  // Restrained page-load reveal — skipped entirely under reduced-motion.
  const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && !mq.matches) {
    hero.animate(
      [
        { opacity: 0, transform: 'translateY(10px)' },
        { opacity: 1, transform: 'translateY(0)' },
      ],
      { duration: 520, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both' },
    );
  }
</script>
